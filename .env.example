# Copia este archivo como .env y completa los valores antes de arrancar.
# El .env real está en .gitignore y nunca se sube al repositorio.

# URL de conexión a PostgreSQL
# Formato: jdbc:postgresql://<host>:<puerto>/<nombre_base_de_datos>
DB_URL=jdbc:postgresql://localhost:5432/bqrines

# Usuario de PostgreSQL
DB_USER=postgres

# Contraseña de PostgreSQL
DB_PASSWORD=tu_password_aqui
